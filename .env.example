# FoxBridge — SwiftFox ↔ Microsoft Dynamics
# Copy to .env and fill in live credentials. Sample data is used when keys are omitted.

PORT=8787

# SwiftFox External API Gateway
# Create a key in Settings → Integrations → API keys.
# Auth header: Authorization: Bearer <key>
SWIFTFOX_BASE_URL=https://api.swiftfoxcrm.com
SWIFTFOX_API_KEY=

# Microsoft Dynamics 365 / Dataverse
# App registration needs the Dynamics CRM user_impersonation / Dataverse scope.
DYNAMICS_ORG_URL=https://yourorg.crm.dynamics.com
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_API_VERSION=v9.2

# Optional shared secret checked against X-Webhook-Secret
WEBHOOK_SECRET=
